  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "通用的主要提交或发布操作。",
      "html": "<button type=\"button\" class=\"ds-btn-primary\">发布作品</button>",
      "css": ".ds-btn-primary{height:38px;padding:0 20px;border:1px solid transparent;border-radius:var(--radius,10px);background:var(--accent,#7C8B7F);color:#fff;font:500 14px/1.4 Inter,\"PingFang SC\",sans-serif;cursor:pointer;transition:background 140ms cubic-bezier(.2,.8,.2,1),transform 140ms cubic-bezier(.2,.8,.2,1)}.ds-btn-primary:hover{background:var(--accent-hover,#6B7A6E);transform:translateY(-1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#7C8B7F);outline-offset:3px}.ds-btn-primary:active{transform:none}"
    },
    {
      "name": "首页主按钮",
      "kind": "button",
      "refersTo": "button-featured",
      "description": "首页首屏的深雾绿行动按钮。",
      "html": "<button type=\"button\" class=\"ds-btn-featured\">发布作品</button>",
      "css": ".ds-btn-featured{height:46px;padding:0 26px;border:0;border-radius:var(--radius-lg,16px);background:var(--accent-ink,#4F5F53);color:#fff;font:500 16px/1.4 Inter,\"PingFang SC\",sans-serif;cursor:pointer;transition:background 140ms cubic-bezier(.2,.8,.2,1),transform 140ms cubic-bezier(.2,.8,.2,1)}.ds-btn-featured:hover{background:var(--accent-hover,#6B7A6E);transform:translateY(-1px)}.ds-btn-featured:focus-visible{outline:2px solid var(--accent,#7C8B7F);outline-offset:3px}.ds-btn-featured:active{transform:none}"
    },
    {
      "name": "次要按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "低强调度的返回、取消与辅助操作。",
      "html": "<button type=\"button\" class=\"ds-btn-secondary\">查看详情</button>",
      "css": ".ds-btn-secondary{height:38px;padding:0 18px;border:1px solid var(--border,#E6E6E1);border-radius:var(--radius,10px);background:var(--surface,#fff);color:var(--text-2,#5A5A56);font:500 14px/1.4 Inter,\"PingFang SC\",sans-serif;cursor:pointer;transition:border-color 140ms cubic-bezier(.2,.8,.2,1),color 140ms cubic-bezier(.2,.8,.2,1)}.ds-btn-secondary:hover{border-color:var(--accent,#7C8B7F);color:var(--accent-ink,#4F5F53)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent,#7C8B7F);outline-offset:2px}.ds-btn-secondary:active{background:var(--accent-soft,#E9EFE9)}"
    },
    {
      "name": "搜索输入",
      "kind": "input",
      "refersTo": "search-field",
      "description": "导航与搜索页使用的白底搜索控件。",
      "html": "<label class=\"ds-search\"><span class=\"ds-search-label\">搜索</span><input type=\"search\" placeholder=\"搜索作品 / 摄影师 / 专题\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;min-width:260px;height:38px;padding:0 12px;border:1px solid var(--border,#E6E6E1);border-radius:var(--radius,10px);background:var(--surface,#fff);color:var(--text-3,#8E8E88);font:400 13px/1.4 Inter,\"PingFang SC\",sans-serif;transition:border-color 140ms cubic-bezier(.2,.8,.2,1),box-shadow 140ms cubic-bezier(.2,.8,.2,1)}.ds-search-label{font-size:12px;color:var(--text-3,#8E8E88)}.ds-search input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--text-1,#1C1C1A);font:inherit}.ds-search:focus-within{border-color:var(--accent,#7C8B7F);box-shadow:0 0 0 3px rgba(124,139,127,.18)}"
    },
    {
      "name": "公共导航",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "浅色吸顶导航中的当前项与普通项。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a class=\"ds-nav-item ds-nav-active\" href=\"#\">发现</a><a class=\"ds-nav-item\" href=\"#\">作品社区</a><a class=\"ds-nav-item\" href=\"#\">专题展览</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:4px;padding:6px;background:rgba(255,255,255,.88);border-bottom:1px solid var(--border,#E6E6E1);font:400 14px/1.4 Inter,\"PingFang SC\",sans-serif}.ds-nav-item{position:relative;display:inline-block;padding:8px 14px;border-radius:999px;color:var(--text-2,#5A5A56);text-decoration:none;transition:background 140ms cubic-bezier(.2,.8,.2,1),color 140ms cubic-bezier(.2,.8,.2,1)}.ds-nav-item:hover{background:var(--surface-2,#F1F1EE);color:var(--text-1,#1C1C1A)}.ds-nav-item:focus-visible{outline:2px solid var(--accent,#7C8B7F);outline-offset:2px}.ds-nav-active{color:var(--accent-ink,#4F5F53);font-weight:600}.ds-nav-active:after{content:\"\";position:absolute;left:50%;bottom:1px;width:4px;height:4px;border-radius:50%;background:var(--accent,#7C8B7F);transform:translateX(-50%)}"
    },
    {
      "name": "筛选胶囊",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "作品流排序与搜索筛选的选中状态。",
      "html": "<button type=\"button\" class=\"ds-chip ds-chip-active\" aria-pressed=\"true\">最新</button>",
      "css": ".ds-chip{padding:6px 16px;border:1px solid var(--border,#E6E6E1);border-radius:999px;background:var(--surface,#fff);color:var(--text-2,#5A5A56);font:500 13px/1.4 Inter,\"PingFang SC\",sans-serif;cursor:pointer;transition:background 140ms cubic-bezier(.2,.8,.2,1),border-color 140ms cubic-bezier(.2,.8,.2,1),color 140ms cubic-bezier(.2,.8,.2,1)}.ds-chip:hover{border-color:var(--accent,#7C8B7F);color:var(--text-1,#1C1C1A)}.ds-chip:focus-visible{outline:2px solid var(--accent,#7C8B7F);outline-offset:2px}.ds-chip-active{background:var(--accent-soft,#E9EFE9);border-color:var(--accent,#7C8B7F);color:var(--accent-ink,#4F5F53);font-weight:600}"
    },
    {
      "name": "作品卡片",
      "kind": "card",
      "refersTo": "work-card",
      "description": "图片优先的自定义作品卡片，操作在交互时显现。",
      "html": "<article class=\"ds-work-card\" tabindex=\"0\"><div class=\"ds-work-cover\"><span>作品封面</span><div class=\"ds-work-actions\"><button type=\"button\">♡ 收藏</button></div></div><div class=\"ds-work-body\"><h3>光线经过的地方</h3><p>摄影师 · 城市漫游</p></div></article>",
      "css": ".ds-work-card{width:260px;overflow:hidden;border:1px solid var(--border,#E6E6E1);border-radius:var(--radius-lg,16px);background:var(--surface,#fff);color:var(--text-1,#1C1C1A);font:400 14px/1.5 Inter,\"PingFang SC\",sans-serif;cursor:pointer;transition:transform 220ms cubic-bezier(.2,.8,.2,1),box-shadow 220ms cubic-bezier(.2,.8,.2,1),border-color 220ms cubic-bezier(.2,.8,.2,1)}.ds-work-card:hover{transform:translateY(-3px);border-color:var(--border-strong,#D6D6CF);box-shadow:0 14px 36px rgba(28,28,26,.10),0 4px 12px rgba(28,28,26,.06)}.ds-work-card:focus-visible{outline:2px solid var(--accent,#7C8B7F);outline-offset:3px}.ds-work-cover{position:relative;display:grid;place-items:center;aspect-ratio:3/2;background:var(--surface-2,#F1F1EE);color:var(--text-3,#8E8E88);letter-spacing:.12em}.ds-work-actions{position:absolute;right:10px;bottom:10px;opacity:0;transition:opacity 220ms cubic-bezier(.2,.8,.2,1)}.ds-work-card:hover .ds-work-actions,.ds-work-card:focus-within .ds-work-actions{opacity:1}.ds-work-actions button{padding:5px 10px;border:1px solid rgba(255,255,255,.22);border-radius:999px;background:rgba(20,20,22,.7);color:#fff;cursor:pointer}.ds-work-actions button:focus-visible{outline:2px solid var(--accent,#7C8B7F);outline-offset:2px}.ds-work-body{padding:12px 16px 16px}.ds-work-body h3{margin:0 0 8px;font-size:14px;font-weight:500}.ds-work-body p{margin:0;padding-top:10px;border-top:1px solid var(--border,#E6E6E1);color:var(--text-2,#5A5A56);font-size:12px}"
    },
    {
